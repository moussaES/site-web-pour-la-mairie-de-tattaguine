{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "rewrites": [
    {
      "source": "/assets/(.*)",
      "destination": "/public/assets/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/public/uploads/$1"
    },
    {
      "source": "/firebase-messaging-sw.js",
      "destination": "/public/firebase-messaging-sw.js"
    },
    {
      "source": "/:path*",
      "destination": "/api/index.php"
    }
  ]
}
